# Website / local development settings (the Android build reads the same values from GitHub variables).
# Supabase > Connect (top of the project page) or Settings > API Keys. The publishable key (sb_publishable_...) goes in ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Your public website address (used for checkout links from the Android app and email links)
NEXT_PUBLIC_SITE_URL=https://licensingbros.com

# Server secrets are NOT set here. They live in Supabase (Edge Function secrets) and are set
# automatically by the GitHub workflow from your repository secrets:
#   ANTHROPIC_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, IPINFO_TOKEN (optional), SITE_URL
